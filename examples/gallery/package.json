{
  "name": "gallery",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive native WinUI 3 control and framework gallery for dynwinrt-jsx.",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "setup": "npm run build:dynwinrt && node scripts/setup.js",
    "generate": "npm run build:dynwinrt && winapp node generate-bindings",
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build:dynwinrt && node dev.js",
    "start": "npm run build:dynwinrt && npm run build && node main.js",
    "smoke:ui": "pwsh -NoProfile -File scripts/smoke-ui.ps1",
    "test:lifecycle": "npm run build && node --test tests/*.test.js",
    "build:dynwinrt": "node scripts/build-local-dynwinrt.js",
    "build:codegen": "npm run build:dynwinrt"
  },
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#winapp/bindings": {
      "types": "./.winapp/bindings/index.d.ts",
      "require": "./.winapp/bindings/index.js",
      "default": "./.winapp/bindings/index.js"
    },
    "#winapp/bindings/*": {
      "types": "./.winapp/bindings/*.d.ts",
      "default": "./.winapp/bindings/*.js"
    }
  },
  "dependencies": {
    "@microsoft/dynwinrt": "file:../../../dynwinrt/bindings/js",
    "dynwinrt-jsx": "file:../.."
  },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "file:tools/local-codegen",
    "@microsoft/winappcli": "0.5.0",
    "typescript": "5.9.2"
  },
