{
  "name": "dynwinrt-jsx-signal-grid-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "build:dynwinrt": "node scripts/build-local-dynwinrt.js",
    "setup": "npm run build:dynwinrt && winapp restore",
    "generate": "npm run build:dynwinrt && winapp node generate-bindings",
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/verify-workload.js",
    "start": "npm run build && node main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#winapp/bindings": {
      "types": "./.winapp/bindings/index.d.ts",
      "require": "./.winapp/bindings/index.js",
      "default": "./.winapp/bindings/index.js"
    },
    "#winapp/bindings/*": {
      "types": "./.winapp/bindings/*.d.ts",
      "require": "./.winapp/bindings/*.js",
      "default": "./.winapp/bindings/*.js"
    }
  },
  "dependencies": {
    "@microsoft/dynwinrt": "file:../../../../dynwinrt/bindings/js",
    "dynwinrt-jsx": "file:../../.."
  },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "file:tools/local-codegen",
    "@microsoft/winappcli": "file:../../../../winappCli/src/winapp-npm",
    "typescript": "5.9.2"
  },
  "winapp": {
    "jsBindings": {
      "additionalWinmds": [
        {
          "namespace": "Windows.Foundation",
          "classes": [
            "PropertyValue"
          ]
        },
        {
          "namespace": "Microsoft.UI.Windowing",
          "classes": [
            "AppWindow"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml",
          "classes": [
            "Application",
            "Window"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Controls",
          "classes": [
            "Button",
            "Border",
            "ColumnDefinition",
            "ContentControl",
            "Grid",
            "ItemsRepeater",
            "RowDefinition",
            "ScrollViewer",
            "Slider",
            "StackPanel",
            "StackLayout",
            "TextBlock",
            "ToggleSwitch"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Media",
          "classes": [
            "CompositionTarget",
            "SolidColorBrush"
          ]
        }
      ]
    }
  }
}
