{
  "name": "dynwinrt-jsx-minimal-app",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal native WinUI 3 app built with dynwinrt-jsx.",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "setup": "winapp restore",
    "generate": "winapp node generate-bindings",
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node main.js",
    "start": "npm run build && node main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#winapp/bindings": {
      "types": "./.winapp/bindings/index.d.ts",
      "require": "./.winapp/bindings/index.js",
      "default": "./.winapp/bindings/index.js"
    }
  },
  "dependencies": {
    "@microsoft/dynwinrt": "0.1.0",
    "dynwinrt-jsx": "1.0.0"
  },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "0.1.0",
    "@microsoft/winappcli": "1.0.0",
    "typescript": "5.9.2"
  },
  "winapp": {
    "jsBindings": {
      "additionalWinmds": [
        {
          "namespace": "Windows.Foundation",
          "classes": [
            "PropertyValue"
          ]
        },
        {
          "namespace": "Microsoft.UI.Windowing",
          "classes": [
            "AppWindow"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml",
          "classes": [
            "Application",
            "ResourceDictionary",
            "Window"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Automation",
          "classes": [
            "AutomationProperties"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Controls",
          "classes": [
            "Button",
            "StackPanel",
            "TextBlock"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Media",
          "classes": [
            "MicaBackdrop"
          ]
        }
      ]
    }
  }
}
